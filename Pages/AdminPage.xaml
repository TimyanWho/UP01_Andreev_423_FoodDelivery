<Page x:Class="UP01_Andreev_423_FoodDelivery.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="Панель администратора" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentDarkBrush}" />
            <TextBlock Text="Выберите таблицу, чтобы просматривать и изменять записи непосредственно через контекст EDMX." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ComboBox x:Name="TableSelector" Width="205" Margin="4" ToolTip="Выберите таблицу базы данных" SelectionChanged="TableSelector_SelectionChanged">
                <ComboBoxItem Content="Роли пользователей" Tag="roles" />
                <ComboBoxItem Content="Пользователи" Tag="users" />
                <ComboBoxItem Content="Адреса доставки" Tag="addresses" />
                <ComboBoxItem Content="Рестораны" Tag="restaurants" />
                <ComboBoxItem Content="Категории меню" Tag="categories" />
                <ComboBoxItem Content="Блюда" Tag="dishes" />
                <ComboBoxItem Content="Заказы" Tag="orders" />
                <ComboBoxItem Content="Состав заказов" Tag="order_items" />
                <ComboBoxItem Content="Оплаты" Tag="payments" />
                <ComboBoxItem Content="Курьеры" Tag="couriers" />
                <ComboBoxItem Content="Доставки" Tag="deliveries" />
                <ComboBoxItem Content="Отзывы" Tag="reviews" />
            </ComboBox>
            <Button Content="Диаграммы и отчёты" Margin="4" Click="DiagramButton_Click" ToolTip="Просмотр диаграмм и экспорт отчётов" />
        </WrapPanel>

        <WrapPanel Grid.Row="2" Margin="0,0,0,8" VerticalAlignment="Center">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="4" />
            <TextBox x:Name="SearchBox" Width="150" Margin="4" ToolTip="Введите текст для поиска" TextChanged="SearchBox_TextChanged" />
            <TextBlock Text="Искать в:" VerticalAlignment="Center" Margin="4" />
            <ComboBox x:Name="SearchColumnBox" Width="140" Margin="4" ToolTip="Поле поиска" SelectionChanged="FilterSelection_Changed" />
            <TextBlock Text="Сортировать:" VerticalAlignment="Center" Margin="4" />
            <ComboBox x:Name="SortColumnBox" Width="140" Margin="4" ToolTip="Столбец сортировки" SelectionChanged="FilterSelection_Changed" />
            <ComboBox x:Name="SortDirectionBox" Width="130" Margin="4" ToolTip="Направление сортировки" SelectionChanged="FilterSelection_Changed">
                <ComboBoxItem Content="По возрастанию" Tag="asc" />
                <ComboBoxItem Content="По убыванию" Tag="desc" />
            </ComboBox>
            <Button Content="Сбросить" Margin="4" Style="{StaticResource SecondaryButton}" Click="ResetFilters_Click" ToolTip="Очистить поиск и вернуть сортировку по умолчанию" />
        </WrapPanel>

        <DataGrid x:Name="RecordsGrid" Grid.Row="3" Margin="2"
                  AutoGenerateColumns="False" IsReadOnly="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" SelectionMode="Extended"
                  SelectionUnit="FullRow" AlternationCount="2"
                  Background="{DynamicResource PanelBackground}"
                  Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource GridCellBackground}"
                  AlternatingRowBackground="{DynamicResource WindowBackground}"
                  GridLinesVisibility="All" HeadersVisibility="Column"
                  ToolTip="Редактируйте значения прямо в ячейках, затем нажмите «Сохранить изменения».">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource GridHeaderBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="8,6" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="Padding" Value="5,3" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectionForeground}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
        </DataGrid>

        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="2,8,2,0">
            <Button Content="Добавить запись" Margin="4" Click="AddRecord_Click" ToolTip="Добавить новую запись выбранного типа" />
            <Button Content="Сохранить изменения" Margin="4" Click="SaveChanges_Click" ToolTip="Сохранить отредактированные ячейки в SQL Server" />
            <Button Content="Удалить выбранные" Margin="4" Style="{StaticResource DangerButton}" Click="DeleteSelected_Click" ToolTip="Удалить выделенные записи с подтверждением" />
            <Button Content="Обновить" Margin="4" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" ToolTip="Загрузить данные заново" />
        </WrapPanel>
    </Grid>
</Page>
