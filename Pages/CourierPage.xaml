<Page x:Class="UP01_Andreev_423_FoodDelivery.Pages.CourierPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Кабинет курьера">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="4,0,4,8">
            <TextBlock Text="Кабинет курьера" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Принимайте свободные доставки, отмечайте получение заказа и завершайте доставку клиенту."
                       Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <DataGrid Grid.Row="1" x:Name="DeliveriesGrid" Margin="4" IsReadOnly="True" AutoGenerateColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Доставка" Binding="{Binding DeliveryId}" Width="80" />
                <DataGridTextColumn Header="Заказ" Binding="{Binding OrderId}" Width="80" />
                <DataGridTextColumn Header="Клиент" Binding="{Binding Customer}" Width="180" />
                <DataGridTextColumn Header="Ресторан" Binding="{Binding Restaurant}" Width="155" />
                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*" />
                <DataGridTextColumn Header="Статус доставки" Binding="{Binding DeliveryStatus}" Width="150" />
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=N2}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Margin="4,8,4,0">
            <TextBlock x:Name="CourierInfoText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="6,0,6,4" />
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" ToolTip="Обновить список доступных доставок" />
                <Button Content="Взять доставку" Click="TakeDelivery_Click" ToolTip="Назначить выбранную свободную доставку за собой" />
                <Button Content="Заказ забран" Click="PickupDelivery_Click" ToolTip="Отметить, что заказ забран из ресторана" />
                <Button Content="Доставлено" Click="CompleteDelivery_Click" ToolTip="Завершить выбранную доставку" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Page>
