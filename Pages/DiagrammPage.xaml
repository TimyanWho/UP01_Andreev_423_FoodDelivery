<Page x:Class="UP01_Andreev_423_FoodDelivery.Pages.DiagrammPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
      Title="Диаграммы и отчёты">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="4,0,4,8">
            <TextBlock Text="Диаграммы и отчёты" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Фильтр по ресторану применяется одновременно к диаграмме и обоим видам экспорта."
                       Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Left" Margin="0,0,0,6" VerticalAlignment="Center">
            <TextBlock Text="Ресторан:" VerticalAlignment="Center" Margin="6" />
            <ComboBox x:Name="CmbRestaurant" Width="235" SelectionChanged="UpdateChart" ToolTip="Фильтр данных по ресторану" />
            <TextBlock Text="Диаграмма:" VerticalAlignment="Center" Margin="6" />
            <ComboBox x:Name="CmbDiagram" Width="155" SelectionChanged="UpdateChart" ToolTip="Тип диаграммы" />
            <Button Content="Экспорт DOCX/PDF" ToolTip="Создать отчёт Word и PDF" Click="ExportWord_Click" />
            <Button Content="Экспорт Excel" Style="{StaticResource SecondaryButton}" ToolTip="Создать книгу Excel" Click="ExportExcel_Click" />
        </WrapPanel>
        <DockPanel Grid.Row="2" Margin="4">
            <TextBlock x:Name="ReportSummary" DockPanel.Dock="Top" Margin="4,0,4,6"
                       Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" />
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackground}" Padding="4">
                <wfi:WindowsFormsHost x:Name="ChartHost" />
            </Border>
        </DockPanel>
    </Grid>
</Page>
