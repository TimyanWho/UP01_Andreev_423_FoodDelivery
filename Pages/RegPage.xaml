<Page x:Class="UP01_Andreev_423_FoodDelivery.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Width="760" MinHeight="590" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="75" />
                <RowDefinition Height="*" />
                <RowDefinition Height="65" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Создание учётной записи" FontSize="27" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentDarkBrush}" />
            <Grid Grid.Row="1" Width="620" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" /><RowDefinition Height="58" /><RowDefinition Height="58" />
                    <RowDefinition Height="58" /><RowDefinition Height="58" /><RowDefinition Height="58" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Логин" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtbxLog" ToolTip="Только английские буквы, цифры, _ и -" />
                <Label Grid.Row="1" Content="ФИО" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtbxFIO" ToolTip="Фамилия, имя и отчество" />
                <Label Grid.Row="2" Content="Телефон" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtbxPhone" ToolTip="Телефон, например +7 900 123-45-67" />
                <Label Grid.Row="3" Content="Электронная почта" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtbxEmail" ToolTip="Необязательно: name@example.com" />
                <Label Grid.Row="4" Content="Пароль" VerticalAlignment="Center" />
                <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="passBxFrst" ToolTip="Минимум 6 символов: английские буквы и цифра" />
                <Label Grid.Row="5" Content="Повторите пароль" VerticalAlignment="Center" />
                <PasswordBox Grid.Row="5" Grid.Column="1" x:Name="passBxScnd" ToolTip="Повторите пароль без ошибок" />
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Зарегистрироваться" ToolTip="Создать новую учётную запись" Click="regButton_Click" />
                <Button Content="Назад ко входу" Style="{StaticResource SecondaryButton}" ToolTip="Вернуться на авторизацию" Click="Back_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
