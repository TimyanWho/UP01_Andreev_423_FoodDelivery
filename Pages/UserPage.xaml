<Page x:Class="UP01_Andreev_423_FoodDelivery.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Кабинет пользователя">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="4,0,4,8">
            <TextBlock Text="Кабинет пользователя" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Выбирайте блюда, оформляйте заказы, управляйте адресами и оставляйте отзывы после доставки."
                       Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <TabControl Grid.Row="1" Margin="0,6,0,0">
            <TabItem Header="Меню">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock Text="Ресторан:" VerticalAlignment="Center" Margin="6" />
                        <ComboBox x:Name="RestaurantBox" Width="220" DisplayMemberPath="Name"
                                  SelectionChanged="RestaurantBox_SelectionChanged" ToolTip="Показать меню выбранного ресторана" />
                        <TextBlock Text="Поиск блюда:" VerticalAlignment="Center" Margin="6" />
                        <TextBox x:Name="DishSearchBox" Width="220" ToolTip="Поиск по названию, категории или описанию"
                                 TextChanged="DishSearchBox_TextChanged" />
                        <ComboBox x:Name="DishSortBox" Width="165" SelectedIndex="0"
                                  SelectionChanged="DishSortBox_SelectionChanged" ToolTip="Порядок сортировки блюд">
                            <ComboBoxItem Content="По названию" />
                            <ComboBoxItem Content="Сначала дешевле" />
                            <ComboBoxItem Content="Сначала дороже" />
                        </ComboBox>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" x:Name="DishesGrid" Margin="4" IsReadOnly="True" AutoGenerateColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ресторан" Binding="{Binding RestaurantName}" Width="160" />
                            <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="135" />
                            <DataGridTextColumn Header="Блюдо" Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=N2}" Width="95" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2" Margin="4,6,4,0" VerticalAlignment="Center">
                        <TextBlock Text="Количество:" VerticalAlignment="Center" Margin="6" />
                        <TextBox x:Name="QuantityBox" Text="1" Width="70" ToolTip="Количество выбранного блюда" />
                        <Button Content="Добавить в корзину" Click="AddToCart_Click" ToolTip="Добавить выбранное блюдо в корзину" />
                        <Button Content="Обновить меню" Click="RefreshCatalog_Click" Style="{StaticResource SecondaryButton}" ToolTip="Загрузить актуальное меню из базы данных" />
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Корзина и заказ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" x:Name="CartGrid" Margin="4" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Блюдо" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=N2}" Width="105" />
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="85" />
                            <DataGridTextColumn Header="Сумма" Binding="{Binding LineTotal, StringFormat=N2}" Width="115" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="1" Margin="4,6,4,0" VerticalAlignment="Center">
                        <TextBlock Text="Адрес доставки:" VerticalAlignment="Center" Margin="6" />
                        <ComboBox x:Name="OrderAddressBox" Width="270" DisplayMemberPath="AddressText"
                                  SelectionChanged="OrderAddressBox_SelectionChanged" ToolTip="Выберите свой адрес доставки" />
                        <TextBlock Text="Оплата:" VerticalAlignment="Center" Margin="6" />
                        <ComboBox x:Name="PaymentBox" Width="135" SelectedIndex="0" ToolTip="Способ оплаты">
                            <ComboBoxItem Content="Карта" />
                            <ComboBoxItem Content="Наличные" />
                            <ComboBoxItem Content="SberPay" />
                        </ComboBox>
                    </WrapPanel>
                    <StackPanel Grid.Row="2" Margin="4,4,4,0">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Комментарий курьеру:" VerticalAlignment="Center" Margin="6" />
                            <TextBox x:Name="OrderCommentBox" Width="300" MaxLength="500" ToolTip="Необязательно: домофон, подъезд, пожелания" />
                            <TextBlock x:Name="CartTotalText" Text="Итого: 0,00 ₽" FontWeight="Bold" VerticalAlignment="Center" Margin="12,4" />
                        </WrapPanel>
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Убрать выбранное" Style="{StaticResource SecondaryButton}" Click="RemoveCartItem_Click" ToolTip="Удалить выбранное блюдо из корзины" />
                            <Button Content="Оформить заказ" Click="PlaceOrder_Click" ToolTip="Создать заказ и доставку" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Мои заказы">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBox x:Name="OrderSearchBox" Width="220" ToolTip="Поиск по ресторану, статусу или адресу"
                                 TextChanged="OrderSearchBox_TextChanged" />
                        <ComboBox x:Name="OrderStatusBox" Width="175" SelectedIndex="0" ToolTip="Фильтр по статусу"
                                  SelectionChanged="OrderFilter_SelectionChanged">
                            <ComboBoxItem Content="Все статусы" /><ComboBoxItem Content="Новый" /><ComboBoxItem Content="Принят" />
                            <ComboBoxItem Content="Готовится" /><ComboBoxItem Content="Готов" /><ComboBoxItem Content="Передан курьеру" />
                            <ComboBoxItem Content="Доставляется" /><ComboBoxItem Content="Доставлен" /><ComboBoxItem Content="Отменён" />
                        </ComboBox>
                        <ComboBox x:Name="OrderSortBox" Width="170" SelectedIndex="0" ToolTip="Сортировка заказов"
                                  SelectionChanged="OrderFilter_SelectionChanged">
                            <ComboBoxItem Content="Сначала новые" /><ComboBoxItem Content="Сначала старые" />
                            <ComboBoxItem Content="Сумма: больше" /><ComboBoxItem Content="Сумма: меньше" />
                        </ComboBox>
                        <Button Content="Сбросить" Style="{StaticResource SecondaryButton}" Click="ClearOrderFilters_Click" ToolTip="Сбросить поиск и фильтры" />
                        <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Click="RefreshOrders_Click" ToolTip="Обновить список заказов" />
                        <Button Content="Отменить заказ" Style="{StaticResource DangerButton}" Click="CancelSelectedOrder_Click" ToolTip="Отменить свой заказ, пока курьер ещё не назначен" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" x:Name="OrdersGrid" Margin="4" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="55" />
                            <DataGridTextColumn Header="Ресторан" Binding="{Binding Restaurant}" Width="160" />
                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="145" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="140" />
                            <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat=N2}" Width="100" />
                            <DataGridTextColumn Header="Адрес доставки" Binding="{Binding Address}" Width="*" />
                            <DataGridTextColumn Header="Оплата" Binding="{Binding PaymentMethod}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Мои адреса">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" x:Name="AddressesGrid" Margin="4" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="65" />
                            <DataGridTextColumn Header="Адрес доставки" Binding="{Binding address_text}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="1" Margin="4,8,4,0" VerticalAlignment="Center">
                        <TextBlock Text="Новый адрес:" VerticalAlignment="Center" Margin="6" />
                        <TextBox x:Name="AddressInput" Width="390" MaxLength="300" ToolTip="Введите полный адрес доставки" />
                        <Button Content="Добавить адрес" Click="AddAddress_Click" ToolTip="Сохранить адрес в своей учётной записи" />
                        <Button Content="Удалить выбранный" Style="{StaticResource DangerButton}" Click="DeleteAddress_Click"
                                ToolTip="Удалить адрес, если он не используется в заказах" />
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Мои отзывы">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" x:Name="ReviewsGrid" Margin="4" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ресторан" Binding="{Binding RestaurantName}" Width="180" />
                            <DataGridTextColumn Header="Заказ №" Binding="{Binding OrderId}" Width="85" />
                            <DataGridTextColumn Header="Оценка" Binding="{Binding Rating}" Width="80" />
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*" />
                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="115" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Margin="4,8,4,0" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBackground}">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Заказ для отзыва:" VerticalAlignment="Center" Margin="6" />
                            <ComboBox x:Name="ReviewOrderBox" Width="280" DisplayMemberPath="Title" ToolTip="Выберите доставленный заказ" />
                            <TextBlock Text="Оценка:" VerticalAlignment="Center" Margin="6" />
                            <ComboBox x:Name="ReviewRatingBox" Width="150" SelectedIndex="0" ToolTip="Оценка от 1 до 5">
                                <ComboBoxItem Content="5 — Отлично" /><ComboBoxItem Content="4 — Хорошо" />
                                <ComboBoxItem Content="3 — Нормально" /><ComboBoxItem Content="2 — Плохо" />
                                <ComboBoxItem Content="1 — Очень плохо" />
                            </ComboBox>
                            <TextBox x:Name="ReviewCommentBox" Width="230" MaxLength="1000" ToolTip="Комментарий к заказу (необязательно)" />
                            <Button Content="Оставить отзыв" Click="AddReview_Click" ToolTip="Добавить отзыв к доставленному заказу" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
